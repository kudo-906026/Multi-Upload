# Server Configuration
PORT=10000
NODE_ENV=production
PUBLIC_BASE_URL=https://<your-app-name>.onrender.com

# Supabase (Database, Auth & Storage)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>
SUPABASE_SECRET_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=videos

# Google Gemini API
GEMINI_API_KEY=<your-gemini-api-key>

# Google OAuth 2.0 (YouTube Data API v3)
# Redirect URI: https://<your-app-name>.onrender.com/api/auth/youtube/callback
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Meta / Instagram Graph API
# Redirect URI: https://<your-app-name>.onrender.com/api/auth/instagram/callback
META_APP_ID=<your-meta-app-id>
META_APP_SECRET=<your-meta-app-secret>

# Token Encryption Key (AES-256-GCM, minimum 32 characters)
TOKEN_ENCRYPTION_KEY=<random-32-character-string>
