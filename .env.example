# ==============================================================================
# OmniPost Video - Developer App Credentials (.env)
# ==============================================================================
# All user accounts (YouTube channels & Instagram accounts) are connected
# in-app via standard OAuth 2.0 and encrypted on the backend.
# No manual user tokens or account IDs belong in this file!
# ==============================================================================

# Server Port (Cloud Run injects PORT=8080 automatically)
PORT=8080
NODE_ENV=development

# 1. Public Base URL (Required for OAuth redirects and Instagram video fetching)
# In production on Cloud Run, set this to your service URL: https://<service-name>.run.app
PUBLIC_BASE_URL=http://localhost:8080

# 2. Gemini API Key (Required for AI trend analysis and Google Search Grounding)
# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Google OAuth 2.0 Credentials (YouTube Data API v3)
# Register Authorized Redirect URI in Google Cloud Console:
# -> ${PUBLIC_BASE_URL}/api/auth/youtube/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 4. Meta App Credentials (Instagram Graph API / Instagram Login)
# Register Valid OAuth Redirect URI in Meta Developer Portal:
# -> ${PUBLIC_BASE_URL}/api/auth/instagram/callback
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# 5. Token Encryption Key (AES-256-GCM for tokens at rest on backend)
# Any random 32+ character string (or 64-char hex string)
TOKEN_ENCRYPTION_KEY=generate_a_secure_random_key_min_32_chars_long

# 6. Google Cloud Storage (Optional external bucket persistence)
GCS_BUCKET_NAME=
