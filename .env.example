# ==============================================================================
# OmniPost Video - Developer App Credentials (.env)
# Zero-Cost Setup (Free Supabase + Free Render Web Service)
# ==============================================================================
# All user accounts (YouTube channels & Instagram accounts) are connected
# in-app via standard OAuth 2.0 and securely encrypted on the backend.
# ==============================================================================

# Server Port (Render injects PORT automatically)
PORT=10000
NODE_ENV=production

# 1. Public Base URL (Required for OAuth redirects and Instagram video fetching)
# On Render: Set to your service URL: https://<your-app-name>.onrender.com
# (Render automatically sets RENDER_EXTERNAL_URL if PUBLIC_BASE_URL is omitted)
PUBLIC_BASE_URL=https://<your-app-name>.onrender.com

# 2. Supabase Configuration (Free Tier Database & Video Storage - No Billing Required!)
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-id>.supabase.co
# Secret / Service Role Key for server-side operations (both SUPABASE_SECRET_KEY & SUPABASE_SERVICE_ROLE_KEY are supported)
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
# Public bucket name for temporary video uploads (default: videos)
SUPABASE_STORAGE_BUCKET=videos

# 3. Gemini API Key (Free Tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Google OAuth 2.0 Credentials (YouTube Data API v3 - Free Google Cloud Project)
# In Google Cloud Console -> APIs & Services -> Credentials:
# Authorized Redirect URI:
# -> https://<your-app-name>.onrender.com/api/auth/youtube/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. Meta App Credentials (Instagram Graph API / Instagram Login - Free Developer Account)
# In Meta Developer Portal -> App Settings -> Basic & Instagram Login:
# Valid OAuth Redirect URI:
# -> https://<your-app-name>.onrender.com/api/auth/instagram/callback
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# 6. Token Encryption Key (AES-256-GCM for tokens at rest on backend)
# Any secure random string (minimum 32 characters)
TOKEN_ENCRYPTION_KEY=generate_a_secure_random_key_min_32_chars_long
