# ==============================================================================
# OmniPost Video - Environment Configuration (.env)
# ==============================================================================

# Server Port (Cloud Run injects PORT=8080 automatically)
PORT=8080
NODE_ENV=development

# Base URL for public access to media (required by Instagram Graph API)
PUBLIC_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Gemini API Key (Required for AI trend analysis and Google Search Grounding)
# Get from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# YouTube Data API v3 (Google Cloud Console OAuth 2.0 Credentials)
# Setup:
# 1. Enable YouTube Data API v3 in Google Cloud Console
# 2. Configure OAuth Consent Screen & Scopes:
#    - https://www.googleapis.com/auth/youtube.upload
#    - https://www.googleapis.com/auth/youtube.readonly
# 3. Create OAuth 2.0 Client ID (Web Application)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_NAME=Verified Creator Channel

# ------------------------------------------------------------------------------
# Meta Instagram Graph API (Reels Publishing)
# Setup:
# 1. Meta for Developers App with Instagram Graph API
# 2. Instagram Business or Creator Account linked to a Facebook Page
# 3. Generate a Long-Lived User Access Token
# ------------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token
INSTAGRAM_USER_ID=your_instagram_business_account_id
INSTAGRAM_HANDLE=@creator_reels
INSTAGRAM_TOKEN_ISSUED_AT=2026-03-01T00:00:00Z

# ------------------------------------------------------------------------------
# Google Cloud Storage (Optional for external bucket persistence)
# ------------------------------------------------------------------------------
GCS_BUCKET_NAME=
